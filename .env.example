# MongoDB - point to your existing NAS instance
MONGO_URI=mongodb://your-nas-ip:27017/budget-buddy

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Backend
PORT=3001
NODE_ENV=production

# Google Sheets Apps Script — optional API key for securing the Sheets endpoints
SHEETS_API_KEY=replace_with_a_random_secret

# Frontend
VITE_API_URL=http://your-nas-ip:3001/api
