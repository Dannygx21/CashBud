# MongoDB - point to your existing NAS instance
MONGO_URI=mongodb://your-nas-ip:27017/budget-buddy

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Backend
PORT=3001
NODE_ENV=production

# Google Sheets (fill in after setting up Google Cloud)
GOOGLE_SHEET_ID=your_google_sheet_id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Frontend
VITE_API_URL=http://your-nas-ip:3001/api
